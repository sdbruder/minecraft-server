[Unit]
Description=Minecraft join alerts (Pushover)
After=network-online.target
Wants=network-online.target

[Service]
User=steve
Environment=HOME=/home/steve
# PUSHOVER_TOKEN / PUSHOVER_USER (root-owned, mode 600); optional so the
# service still starts if the file is missing.
EnvironmentFile=-/etc/mc-alerts.env
ExecStart=/home/steve/minecraft/scripts/alert-nonwhitelist.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
