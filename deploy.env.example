# Site values for deploying this repository to a real host.
#
# Copy to deploy.env (git-ignored) and fill in your own. scripts/install-units.sh
# substitutes them into the templates in systemd/ and nginx/ and writes the
# result to /etc/systemd/system (or to --out DIR for staging).
#
# The values below are the repository's own placeholders (see README, "About
# this repository"): they map 1:1 onto what the templates contain, so replacing
# them is all that is needed.
#
# Everything the *services* need at runtime lives in their own env files on the
# host - dashboard.env, storagebox.env, mc-alerts.env - because those are read by
# processes, not by systemd itself. See README, "Backups"/"Dashboard"/"Alerts".

# Runtime user: User=/Group= in every unit, and the owner of the server tree.
SITE_USER=steve

# Its home, and the Minecraft directory inside it.
SITE_HOME=/home/steve
SITE_MC_DIR=/home/steve/minecraft

# The server as players reach it, and the dashboard's own hostname.
SITE_SERVER_HOST=host.example.com
SITE_DASH_HOST=mc.example.com

# Optional: the bare domain, for prose that is not a hostname — certificate
# wildcards (`*.example.com`), mail addresses. Leave it as the placeholder to
# keep `example.com` in those spots.
SITE_DOMAIN=example.com

# Optional: ssh target for scripts/deploy.sh (defaults to SITE_SERVER_HOST).
SITE_SSH_HOST=host.example.com

# Where the rendered nginx conf belongs on this host (it differs by distro:
# /etc/nginx/conf.d/ or /etc/nginx/sites-available/ + a symlink).
SITE_NGINX_CONF=/etc/nginx/sites-available/mc.example.com.conf